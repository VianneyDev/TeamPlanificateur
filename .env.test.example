# Dedicated Neon branch for API / Vitest runs (schema-only branch recommended).
# Copy to .env.test (gitignored) and fill in the connection string from the Neon console.
# Never commit .env.test - it contains secrets.
#
# Apply schema after creating/updating the branch:
#   pnpm db:migrate:test
#
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
