---
import "@/styles/global.css";
import "@vianneytraina/ui/styles.css";
import AppHeader from "@/components/islands/AppHeader";

const { title = "Planning équipe" } = Astro.props;
const member = Astro.locals.member;
const pathname = Astro.url.pathname;

const memberPayload = member
	? {
			name: member.name as string,
			role: member.role as string,
			isExternal: Boolean(member.isExternal),
			initials: String(member.name)
				.split(/\s+/)
				.filter(Boolean)
				.slice(0, 2)
				.map((part: string) => part[0]?.toUpperCase() ?? "")
				.join(""),
		}
	: null;
---

<!doctype html>
<html lang="fr" class="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<script is:inline>
			(function () {
				try {
					const t = localStorage.getItem("tpe-theme");
					const root = document.documentElement;
					if (t === "dark") {
						root.classList.add("dark");
						root.classList.remove("light");
					} else {
						root.classList.add("light");
						root.classList.remove("dark");
					}
				} catch {
					document.documentElement.classList.add("light");
				}
			})();
		</script>
	</head>
	<body class="flex min-h-dvh flex-col bg-background text-foreground">
		<!--
THESIS: Un dashboard entreprise familier où le mois et les demandes se lisent en un coup d’œil, sans spectacle.
OWN-WORLD: Light-by-default ops chrome, dark toggle, accent bleu, top bar, split calendrier / file; dark lifted (not muddy).
STORY: Le visiteur (membre ou recruteur) comprend immédiatement TPE, navigue, et agit sur le planning.
FIRST VIEWPORT: Top bar TPE + nav (desktop) / menu hamburger (mobile) + thème + Acting Member; sous la barre, calendrier ~65% et rail demandes ~35%.
FORM: seed:canon-comp-b · Canon enterprise dashboard · craft bar Linear + Notion · topnav-split · light default.
FINISH: UX pass — Acting Member menu, mobile nav, theme lift, sticky footer, calendar contrast.
		-->
		<AppHeader client:load pathname={pathname} member={memberPayload} />

		<main class="mx-auto w-full max-w-[1400px] flex-1 px-4 py-6 sm:px-6 sm:py-8">
			<slot />
		</main>

		<footer class="mt-auto border-t border-border bg-card/60">
			<div class="mx-auto flex max-w-[1400px] flex-wrap items-center justify-between gap-3 px-4 py-4 text-sm text-muted-foreground sm:px-6">
				<p>© {new Date().getFullYear()} TPE – Team Planning Engine</p>
				<nav class="flex items-center gap-4" aria-label="Pied de page">
					<a href="#aide" class="transition hover:text-foreground">Aide</a>
					<a href="#confidentialite" class="transition hover:text-foreground">Confidentialité</a>
				</nav>
			</div>
		</footer>
	</body>
</html>

<style>
	html {
		height: 100%;
	}
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		overflow-x: clip;
	}
</style>
