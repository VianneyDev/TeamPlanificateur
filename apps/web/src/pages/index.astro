---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import MemberSelector from "@/components/islands/member/MemberSelector";
import TeamCalendarWithProvider from "@/components/islands/calendar/TeamCalendarWithProvider";
import { isDemoResetEnabled } from "@/lib/demo-reset-enabled";

const selectedMember =
   Astro.locals.member && !Astro.locals.member.archived
      ? Astro.locals.member
      : null;
const demoResetEnabled = isDemoResetEnabled();
---

<Layout title="Calendrier d'équipe">
   <div class="mb-6">
      <h1 class="text-2xl font-semibold tracking-tight text-foreground">
         Calendrier d'équipe
      </h1>
      <p class="mt-1 max-w-2xl text-sm text-muted-foreground">
         Consultez les jours de repos de l'équipe. Les membres soumettent une
         demande ; les managers peuvent corriger directement.
      </p>
   </div>

   {!selectedMember && (
      <div class="flex min-h-[50vh]">
         <MemberSelector client:load demoResetEnabled={demoResetEnabled} />
      </div>
   )}

   {selectedMember && (
      <TeamCalendarWithProvider
         actingMemberId={selectedMember.id}
         actingMemberName={selectedMember.name}
         isManager={selectedMember.role === "manager"}
         client:load
      />
   )}
</Layout>
