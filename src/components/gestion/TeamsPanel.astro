---
import { db } from "@/lib/db";
import TeamModal from "@/components/islands/team/TeamModal";

const teams = await db.team.findMany({
   include: { members: true },
   orderBy: { name: "asc" },
});
---

<div class="bg-slate-900 border border-slate-700 rounded-lg">
   <div class="flex items-center justify-between p-4 border-b border-slate-700">
     <h2 class="text-lg font-semibold text-white">Équipes</h2>
     <TeamModal client:idle />
   </div>
 
   <table class="w-full text-sm">
      <thead class="text-slate-400">
         <tr>
            <th class="px-4 py-3 text-left">Nom</th>
            <th class="px-4 py-3 text-left">Membres</th>
         </tr>
      </thead>
      <tbody>
        {teams.map((team) => (
          <tr>
            <td class="px-4 py-3">{team.name}</td>
            <td class="px-4 py-3">{team.members.length}</td>
          </tr>
        ))}
      </tbody>
    </table>
</div>