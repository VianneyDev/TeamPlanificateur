---
import "../styles/global.css";

const { title = "Planning équipe" } = Astro.props;
const member = Astro.locals.member; 
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-slate-800 text-slate-200 flex">
      <aside class="w-56 bg-slate-900 border-r border-slate-700 flex flex-col">
         <div class="p-6 border-b border-slate-700">
            <a href="/" class="text-xl font-bold text-white tracking-wide">TPE</a>
            <p class="text-xs text-slate-400 mt-1">Planning équipe</p>
         </div>

         <nav class="flex-1 px-3 py-6 space-y-1">
            <a href="/" class="nav-item">
               <span>Dashboard</span>
            </a>
            {member?.role === "manager" && (
               <a href="/gestion" class="nav-item">
                  <span>Gestion</span>
               </a>
            )}
            <a href="/external" class="nav-item">
               <span>Jours travaillés</span>
            </a>
         </nav>

         {member && (
         <div class="p-4 border-t border-slate-700 text-xs text-slate-400">
            {member.name} - {member.team.name}
          </div>
          )}
      </aside>

      <main class="min-h-screen flex-1 px-6 py-8">
         <slot />
      </main>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
