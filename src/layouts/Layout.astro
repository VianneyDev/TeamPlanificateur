---
import "@/styles/global.css";

const { title = "Planning équipe" } = Astro.props;
const member = Astro.locals.member; 
const pathname = Astro.url.pathname;
const isActive = (path: string) => pathname === path;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-slate-800 text-slate-200 flex">
      <aside class="w-56 bg-slate-900 border-r border-slate-700 flex flex-col">
         <div class="p-6 border-b border-slate-700">
            <a href="/" class="text-xl font-bold text-white tracking-wide">TPE</a>
            <p class="text-xs text-slate-400 mt-1">Team Planning Engine</p>
         </div>

         <nav class="flex-1 px-3 py-6 space-y-4">
            <a href="/" class={`nav-item ${isActive("/") ? "nav-item-active" : ""}`}>
               <span>Dashboard</span>
            </a>
            <a href="/external" class={`nav-item ${isActive("/external") ? "nav-item-active" : ""}`}>
               <span>Jours travaillés</span>
            </a>
            {member && member.role === "manager" ? (
              <a href="/gestion" class={`nav-item ${isActive("/gestion") ? "nav-item-active" : ""}`}>
                <span>Gestion</span>
              </a>
            ) : (
              <a
                href="#"
                class="nav-item pointer-events-none opacity-40"
                aria-disabled="true"
                title="Accès réservé aux admins"
              >
                <span>Gestion</span>
              </a>
            )}
         </nav>

         {member && (
            <div class="p-4 border-t border-slate-700 text-xs text-slate-400 flex items-center justify-between gap-2">
              <div class="truncate">
                <div class="text-slate-200 font-medium">{member.name}</div>
                <div class="text-slate-400">{member.team.name}</div>
              </div>
          
              <form method="POST" action="/api/logout">
                <button
                  type="submit"
                  class="text-red-400 hover:text-red-300 text-xs font-medium cursor-pointer"
                >
                  Déconnexion
                </button>
              </form>
            </div>
          )}          
      </aside>

      <main class="min-h-screen flex-1 px-6 py-8">
         <slot />
      </main>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
