---
import "@/styles/global.css";
import ThemeToggle from "@/components/islands/ThemeToggle";

const { title = "Planning équipe" } = Astro.props;
const member = Astro.locals.member;
const pathname = Astro.url.pathname;
const isActive = (path: string) => pathname === path;
---

<!doctype html>
<html lang="fr" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline>
			(function () {
				try {
					const t = localStorage.getItem("tpe-theme");
					const root = document.documentElement;
					if (t === "light") {
						root.classList.add("light");
						root.classList.remove("dark");
					} else {
						root.classList.add("dark");
						root.classList.remove("light");
					}
				} catch {
					document.documentElement.classList.add("dark");
				}
			})();
		</script>
	</head>
	<body class="min-h-screen bg-background text-foreground">
		<!--
THESIS: Un dashboard entreprise familier où le mois et les demandes se lisent en un coup d’œil, sans spectacle.
OWN-WORLD: Dark-by-default ops chrome (#22252c / #2c3039), light toggle, accent bleu, top bar, split calendrier / file.
STORY: Le visiteur (membre ou recruteur) comprend immédiatement TPE, navigue, et agit sur le planning.
FIRST VIEWPORT: Top bar TPE + nav + thème + Acting Member; sous la barre, calendrier ~65% et rail demandes ~35%.
FORM: Canon enterprise dashboard · craft bar Linear + Notion · comp-b topnav-split · dark default.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
		-->
		<header class="sticky top-0 z-40 border-b border-border bg-card/90 backdrop-blur supports-[backdrop-filter]:bg-card/75">
			<div class="mx-auto flex h-14 max-w-[1400px] items-center gap-4 px-4 sm:gap-6 sm:px-6">
				<a href="/" class="shrink-0 leading-tight">
					<span class="block text-sm font-semibold tracking-tight text-foreground">TPE</span>
					<span class="block text-[0.65rem] text-muted-foreground">Team Planning Engine</span>
				</a>

				<nav class="flex flex-1 items-center gap-1 overflow-x-auto" aria-label="Navigation principale">
					<a href="/" class={`nav-item ${isActive("/") ? "nav-item-active" : ""}`}>
						Calendrier
					</a>
					{
						member && (member.isExternal || member.role === "manager") && (
							<a
								href="/external"
								class={`nav-item ${isActive("/external") ? "nav-item-active" : ""}`}
							>
								Jours travaillés
							</a>
						)
					}
					{
						member && member.role === "manager" ? (
							<a
								href="/gestion"
								class={`nav-item ${isActive("/gestion") ? "nav-item-active" : ""}`}
							>
								Gestion
							</a>
						) : (
							<span
								class="nav-item pointer-events-none opacity-50"
								aria-disabled="true"
								title="Accès réservé aux managers"
							>
								Gestion
								<span class="sr-only"> (réservé aux managers)</span>
							</span>
						)
					}
				</nav>

				<div class="flex shrink-0 items-center gap-2 sm:gap-3">
					<ThemeToggle client:load />
					{
						member ? (
							<>
								<div class="hidden text-right text-xs sm:block">
									<div class="font-medium text-foreground">{member.name}</div>
									<div class="max-w-40 truncate text-muted-foreground">
										{member.teams?.length
											? member.teams.map((t: { name: string }) => t.name).join(", ")
											: "—"}
									</div>
								</div>
								<form method="POST" action="/api/logout">
									<button
										type="submit"
										class="rounded-md px-2 py-1.5 text-xs font-medium text-muted-foreground transition hover:bg-muted hover:text-foreground cursor-pointer"
									>
										Déconnexion
									</button>
								</form>
							</>
						) : null
					}
				</div>
			</div>
		</header>

		<main class="mx-auto max-w-[1400px] px-4 py-6 sm:px-6 sm:py-8">
			<slot />
		</main>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}
</style>
