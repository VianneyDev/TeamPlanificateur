---
import "../styles/global.css";

const { title = "Planning équipe" } = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-slate-800 text-slate-200 flex">
      <nav class="bg-slate-900 border-r border-gray-600 shadow-sm">
         <div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col items-center gap-8">
               <a href="/" class="text-xl font-bold text-gray-200">TPE</a>
               <div class="flex flex-col gap-1 text-center">
                  <a href="/" class="px-4 py-2 rounded-md text-sm font-medium text-gray-200 hover:bg-gray-100 hover:text-gray-900">
                     Dashboard
                  </a>
                  <a href="/gestion" class="px-4 py-2 rounded-md text-sm font-medium text-gray-200 hover:bg-gray-100 hover:text-gray-900">
                     Gestion
                  </a>
               </div>
            </div>
         </div>
      </nav>

      <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
         <slot />
      </main>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
