---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import MonthlyWorkedDaysPanelWithProvider from "@/components/islands/monthly-worked-days/MonthlyWorkedDaysPanelWithProvider";

const member = Astro.locals.member;
const isManager = member?.role === "manager";
const isExternal = Boolean(member?.isExternal);
---

<Layout title="Jours travaillés">
  <div class="mb-6">
    <h1 class="text-2xl font-semibold tracking-tight text-foreground">
      Jours travaillés
    </h1>
    <p class="mt-1 max-w-2xl text-sm text-muted-foreground">
      {
        isExternal && !isManager
          ? "Déclarez votre volume mensuel. Indépendant des jours de repos du calendrier."
          : isManager
            ? "Volumes mensuels des membres externes - mois courant et passés uniquement."
            : "Volumes mensuels - mois courant et passés uniquement."
      }
    </p>
  </div>

  {member && (
    <MonthlyWorkedDaysPanelWithProvider
      client:load
      actingMemberId={member.id}
      isManager={isManager}
      isExternal={isExternal}
    />
  )}
</Layout>
