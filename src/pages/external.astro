---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import MonthlyWorkedDaysPanelWithProvider from "@/components/islands/monthly-worked-days/MonthlyWorkedDaysPanelWithProvider";

const member = Astro.locals.member;
---

<Layout title="Jours travaillés">
  <div class="mb-6">
    <h1 class="text-2xl font-semibold tracking-tight text-foreground">
      Jours travaillés
    </h1>
    <p class="mt-1 max-w-2xl text-sm text-muted-foreground">
      Déclarez ou corrigez le volume mensuel des membres externes (mois courant et passés uniquement).
    </p>
  </div>

  <div class="panel p-4 sm:p-5">
    {member && (
      <MonthlyWorkedDaysPanelWithProvider
        client:load
        actingMemberId={member.id}
        isManager={member.role === "manager"}
        isExternal={member.isExternal}
      />
    )}
  </div>
</Layout>
