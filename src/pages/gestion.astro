---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import TeamsPanelWithProvider from "@/components/islands/team/TeamsPanelWithProvider";
import MembersPanelWithProvider from "@/components/islands/member/MembersPanelWithProvider";

const tab = Astro.url.searchParams.get("tab") ?? "teams";

const membersStatus = Astro.url.searchParams.get("status") ?? "active";
const membersPage = Astro.url.searchParams.get("page") ?? "1";
const membersSearch = Astro.url.searchParams.get("search") ?? "";

const teamsStatus = Astro.url.searchParams.get("teamsStatus") ?? "active";
const teamsPage = Astro.url.searchParams.get("teamsPage") ?? "1";
const teamsSearch = Astro.url.searchParams.get("teamsSearch") ?? "";
---

<Layout title="Gestion d'équipe et membres">
   <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-200 mb-2">Gestion</h1>
      <p class="text-gray-400">
         Administration des équipes et des membres
      </p>
   </div>

   <div class="mb-6 flex gap-2 border-b border-slate-700">
      <a href="/gestion?tab=teams" class={`tab ${tab === "teams" ? "tab-active" : "tab"}`}>Équipes</a>
      <a href="/gestion?tab=members" class={`tab ${tab === "members" ? "tab-active" : "tab"}`}>Membres</a>
      <a href="/gestion?tab=externes" class={`tab ${tab === "externes" ? "tab-active" : "tab"}`}>Externes</a>
   </div>

   {tab === "teams" && 
      <TeamsPanelWithProvider
         client:load
         initialTeamsStatus={teamsStatus}
         initialTeamsPage={teamsPage}
         initialTeamsSearch={teamsSearch}
      />
   }

   {tab === "members" && 
      <MembersPanelWithProvider
         client:load
         initialStatus={membersStatus}
         initialPage={membersPage}
         initialSearch={membersSearch}
      />
   }

   {tab === "externes" && 
      <MembersPanelWithProvider
         client:load
         externalOnly
         initialStatus={membersStatus}
         initialPage={membersPage}
         initialSearch={membersSearch}
      />
   }
</Layout>
