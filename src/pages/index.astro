---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import Calendar from "../components/calendar/Calendar.astro";
import MemberSelector from "../components/islands/MemberSelector";
import { db } from "../lib/db";

const selectedMemberId = Astro.cookies.get("selectedMemberId")?.value;

const selectedMember = selectedMemberId 
   ? await db.member.findUnique({
      where: { id: selectedMemberId },
      include: { team: true },
   })
   : null;
---

<Layout>
   <div class="mb-8">
      <h1 class="text-3xl font-bold text-white">Dashboard</h1>
      <p class="text-slate-400 mt-1">Vue d'ensemble de votre planning d'équipe</p>
   </div>

   {!selectedMember && (
      <div class="flex-1 flex">
         <MemberSelector client:load />
      </div>
   )}

   {selectedMember && (
      <div class="mb-8 flex items-center justify-between rounded-lg bg-slate-700 px-4 py-3">
        Yooo
      </div>
    )}
    
</Layout> 