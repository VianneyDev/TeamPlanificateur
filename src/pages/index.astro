---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import MemberSelector from "@/components/islands/member/MemberSelector";
import TeamCalendarWithProvider from "@/components/islands/calendar/TeamCalendarWithProvider";

const selectedMember =
   Astro.locals.member && !Astro.locals.member.archived
      ? Astro.locals.member
      : null;
---

<Layout title="Calendrier d'équipe">
   <div class="mb-8">
      <h1 class="text-3xl font-bold text-white">Calendrier d'équipe</h1>
      <p class="text-slate-400 mt-1">
         Consultez et gérez vos jours de repos mois par mois.
      </p>
   </div>

   {!selectedMember && (
      <div class="flex-1 flex">
         <MemberSelector client:load />
      </div>
   )}

   {selectedMember && (
      <TeamCalendarWithProvider
         actingMemberName={selectedMember.name}
         client:load
      />
   )}
</Layout> 